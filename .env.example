# Copy to .env for `docker compose up`. Generate each secret with:  openssl rand -hex 32

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=
COOKIE_SECRET=
# Encrypts every stored secret (AES-256-GCM). 32 bytes as 64 hex chars.
# Back it up: losing it makes stored credentials unreadable.
CREDENTIALS_MASTER_KEY=

# ── Deployment ──────────────────────────────────────────────────────────────
# selfhost (default): generous limits, private network targets allowed.
# hosted: multi-tenant (routini.tynhub.com) — free-plan limits, open signup,
#         private/loopback addresses blocked for HTTP and SSH steps.
# ROUTINI_MODE=selfhost
# open | first-user-only (self-host default) | closed
# ROUTINI_SIGNUP=first-user-only
# Public URL of the console (CORS + cookies).
# CLIENT_URL=http://localhost
# HTTP_PORT=80
# POSTGRES_PASSWORD=routini

# ── Agents ──────────────────────────────────────────────────────────────────
# Group id of /var/run/docker.sock on this host:  stat -c %g /var/run/docker.sock
# DOCKER_GID=999
# Run agent containers on another host instead (recommended for production):
# DOCKER_HOST=ssh://runner@agent-runner.internal
# ROUTINI_AGENT_IMAGE_CLAUDE=routini/agent-claude:latest
# ROUTINI_WORKER_CONCURRENCY=4
# OCI runtime for agent and environment containers; runsc = gVisor (install it
# on the Docker host first). Unset = Docker's default (runc).
# ROUTINI_CONTAINER_RUNTIME=runsc
# ROUTINI_CONTAINER_PIDS_LIMIT=512
# Hosted mode only: images environments may use (default: the agent images).
# ROUTINI_ENV_IMAGES=routini/agent-claude:latest

# ── Email (optional): verification, password reset, run notifications ──────
# e.g. Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@routini.dev
# SMTP_FROM_NAME=Routini
# Hosted mode with SMTP gates agent steps and environments on a verified email:
# ROUTINI_REQUIRE_VERIFIED_EMAIL=true

# ── Credential broker (recommended; required in hosted mode) ────────────────
# Sandboxed containers reach the network only through the egress proxy, which
# enforces each org's allow-list and injects credentials, so agents never see
# real keys. Turn on with both lines below.
# COMPOSE_PROFILES=broker
# ROUTINI_EGRESS_SECRET=
# ROUTINI_EGRESS_CONTROL_URL=http://egress:3129
# ROUTINI_SANDBOX_NETWORK_PREFIX=routini-sb

# ── Public URL, MCP and sign-in (Phase 4) ──────────────────────────────────
# Where runners, monitoring tools and MCP clients reach this server (default CLIENT_URL).
# ROUTINI_PUBLIC_URL=https://routini.example.com
# Where agent containers reach it for Routini's own tools (default: the public URL).
# ROUTINI_AGENT_API_URL=
# Sign in with TynHub (or any OIDC provider). Register the redirect URI
# <public URL>/api/auth/oidc/callback with the provider.
# ROUTINI_OIDC_ISSUER=https://tynhub.com
# ROUTINI_OIDC_CLIENT_ID=routini
# ROUTINI_OIDC_CLIENT_SECRET=
# ROUTINI_OIDC_NAME=TynHub
