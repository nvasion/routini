# Development image — installs all dependencies so that tsx and other
# devDependencies are available for hot-reload.  Source code is mounted
# at runtime via the docker-compose volume; node_modules stays in the
# image layer and is preserved by the named volume declared in the compose
# file, so container restarts do not re-install packages.
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json* ./
# --ignore-scripts skips arbitrary postinstall scripts (supply-chain hygiene),
# but that also skips better-sqlite3's native binding download — rebuild it
# explicitly so the credential store works inside the container.
RUN npm install --ignore-scripts && npm rebuild better-sqlite3

EXPOSE 3001

CMD ["npm", "run", "dev"]
